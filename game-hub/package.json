{
  "name": "paper-arcade",
  "version": "0.1.0",
  "private": true,
  "description": "A minimalist, zero-backend browser game hub. First game: CRATER // LAB, a destructible-terrain artillery duel (1P vs a ballistics-solver AI, or 2P pass-and-play).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/roms.mjs && vite",
    "build": "node scripts/roms.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "roms": "node scripts/roms.mjs"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.0",
    "chess.js": "^1.4.0",
    "lucide-react": "^0.500.0",
    "nostalgist": "^0.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
