# Copy to .env and fill in. Never commit .env.

# From https://my.telegram.org -> "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# From @BotFather. A bot token is required: only bots can show the inline buttons.
BOT_TOKEN=123456789:replace-with-your-bot-token

# The private channel that holds the videos. Numeric id, starts with -100. The bot must be an ADMINISTRATOR of it.
STORAGE_CHANNEL_ID=-1001234567890

# Optional ---------------------------------------------------------------------------------------------
# Comma-separated Telegram user ids allowed to use the bot. Empty means everyone who finds it can search.
ALLOWED_USER_IDS=
# Comma-separated user ids that may use /stats and /reindex.
ADMIN_IDS=
DB_PATH=library.db
SESSION_NAME=media_bot
